# Google Analytics 4 measurement ID for the Storybook site.
# Replace with your own G-XXXXXXXXXX in .env.local for local dev
# and set the same var in Vercel Project Settings -> Environment Variables.
VITE_GA4_ID=G-XXXXXXXXXX

# Figma personal access token used by scripts/fetch-figma-tokens.mjs
# ONLY needed if you run the fetch script; never commit this value.
# FIGMA_ACCESS_TOKEN=figd_...
