{
  "color": {
    "primitive": {
      "brand": {
        "base": { "$value": "#001484", "$type": "color" }
      },
      "neutral": {
        "0":    { "$value": "#ffffff", "$type": "color" },
        "50":   { "$value": "#fafafc", "$type": "color" },
        "100":  { "$value": "#f4f4f4", "$type": "color" },
        "200":  { "$value": "#e7e7e7", "$type": "color" },
        "300":  { "$value": "#c6c6c6", "$type": "color" },
        "400":  { "$value": "#ada8a8", "$type": "color" },
        "500":  { "$value": "#6f6f6f", "$type": "color" },
        "600":  { "$value": "#49454f", "$type": "color" },
        "700":  { "$value": "#393939", "$type": "color" },
        "800":  { "$value": "#262626", "$type": "color" },
        "900":  { "$value": "#1d1b20", "$type": "color" },
        "1000": { "$value": "#000000", "$type": "color" }
      },
      "cyan": {
        "10":  { "$value": "#e5f6ff", "$type": "color" },
        "50":  { "$value": "#bae6ff", "$type": "color" }
      },
      "error": {
        "50":  { "$value": "#da1e28", "$type": "color" },
        "60":  { "$value": "#b3261e", "$type": "color" }
      },
      "on-brand": { "$value": "#ffffff", "$type": "color" }
    }
  },

  "space": {
    "0":  { "$value": "0",    "$type": "dimension" },
    "1":  { "$value": "2px",  "$type": "dimension" },
    "2":  { "$value": "4px",  "$type": "dimension" },
    "3":  { "$value": "8px",  "$type": "dimension" },
    "4":  { "$value": "12px", "$type": "dimension" },
    "5":  { "$value": "16px", "$type": "dimension" },
    "6":  { "$value": "20px", "$type": "dimension" },
    "7":  { "$value": "24px", "$type": "dimension" },
    "8":  { "$value": "32px", "$type": "dimension" },
    "9":  { "$value": "40px", "$type": "dimension" },
    "10": { "$value": "48px", "$type": "dimension" },
    "12": { "$value": "64px", "$type": "dimension" }
  },

  "radius": {
    "none": { "$value": "0",     "$type": "dimension" },
    "sm":   { "$value": "4px",   "$type": "dimension" },
    "md":   { "$value": "8px",   "$type": "dimension" },
    "lg":   { "$value": "12px",  "$type": "dimension" },
    "pill": { "$value": "384px", "$type": "dimension" }
  },

  "size": {
    "button": {
      "default":  { "$value": "56px", "$type": "dimension" },
      "small":    { "$value": "40px", "$type": "dimension" },
      "xsmall":   { "$value": "32px", "$type": "dimension" }
    },
    "icon": {
      "default":  { "$value": "24px", "$type": "dimension" },
      "small":    { "$value": "20px", "$type": "dimension" },
      "xsmall":   { "$value": "18px", "$type": "dimension" }
    },
    "control": {
      "default":  { "$value": "48px", "$type": "dimension" }
    },
    "focus-ring":     { "$value": "2px", "$type": "dimension" },
    "state-layer":    { "$value": "40px", "$type": "dimension" }
  },

  "font": {
    "family": {
      "serif": { "$value": "\"Roboto Serif\", \"Roboto\", ui-serif, Georgia, serif", "$type": "fontFamilies" },
      "sans":  { "$value": "\"Roboto\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif", "$type": "fontFamilies" }
    },
    "weight": {
      "regular":  { "$value": "400", "$type": "fontWeights" },
      "medium":   { "$value": "500", "$type": "fontWeights" },
      "semibold": { "$value": "600", "$type": "fontWeights" }
    },
    "qwark": {
      "title-medium": {
        "size":         { "$value": "16px",  "$type": "dimension" },
        "line-height":  { "$value": "24px",  "$type": "dimension" },
        "tracking":     { "$value": "0.15px","$type": "dimension" }
      },
      "label-large": {
        "size":         { "$value": "14px",  "$type": "dimension" },
        "line-height":  { "$value": "20px",  "$type": "dimension" },
        "tracking":     { "$value": "0.10px","$type": "dimension" }
      },
      "label-medium": {
        "size":         { "$value": "12px",  "$type": "dimension" },
        "line-height":  { "$value": "16px",  "$type": "dimension" },
        "tracking":     { "$value": "0.5px", "$type": "dimension" }
      }
    }
  },

  "motion": {
    "duration": {
      "fast":  { "$value": "120ms", "$type": "duration" },
      "med":   { "$value": "200ms", "$type": "duration" },
      "slow":  { "$value": "320ms", "$type": "duration" }
    },
    "easing": {
      "standard":   { "$value": "cubic-bezier(0.2, 0, 0, 1)",    "$type": "cubicBezier" },
      "emphasized": { "$value": "cubic-bezier(0.2, 0, 0, 1.15)", "$type": "cubicBezier" },
      "exit":       { "$value": "cubic-bezier(0.4, 0, 1, 1)",    "$type": "cubicBezier" }
    }
  },

  "opacity": {
    "state-hover":   { "$value": "0.08", "$type": "number" },
    "state-focus":   { "$value": "0.10", "$type": "number" },
    "state-pressed": { "$value": "0.12", "$type": "number" },
    "disabled":      { "$value": "0.38", "$type": "number" }
  }
}
